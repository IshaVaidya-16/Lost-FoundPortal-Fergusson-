@model List<Lost_FoundPortal.Models.FoundItem>

@{
    ViewData["Title"] = "Found";
    bool isLoggedIn = ViewBag.IsLoggedIn ?? false;
    int? currentUserId = Context.Session.GetInt32("UserId");
    var users = ViewBag.Users as List<Lost_FoundPortal.Models.Student>;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Found Property</title>
    <link rel="stylesheet" href="~/css/found.css?v=1" />
</head>
<body>

    @if (!isLoggedIn)
    {
        <div id="loginPopup" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:999; justify-content:center; align-items:center;">
            <div style="background:white; padding:40px; border-radius:12px; text-align:center; max-width:380px; width:90%; box-shadow:0 10px 40px rgba(0,0,0,0.3);">
                <h3>Login Required</h3>
                <p style="color:#555; margin:10px 0 24px;">You must be logged in to register a found item.</p>
                <div style="display:flex; gap:12px; justify-content:center;">
                    <a href="/Home/Login" style="padding:10px 24px; background:#2c3e50; color:white; border-radius:6px; text-decoration:none; font-weight:600;">Go to Login</a>
                    <a href="#" onclick="closePopup()" style="padding:10px 24px; background:#eee; color:#333; border-radius:6px; text-decoration:none; font-weight:600;">Cancel</a>
                </div>
            </div>
        </div>
    }

    <div class="topbar">
        <h2>Found Property</h2>
        <a href="/Home/Index" class="back-btn">← Back</a>
    </div>

    @if (isLoggedIn)
    {
        <div class="form-box">
            <h3>Register Found Item</h3>
            <form method="post" asp-action="Found_Items" enctype="multipart/form-data">
                <input type="text" name="ItemName" placeholder="Item Name" required />
                <textarea name="Description" placeholder="Description"></textarea>
                <input type="text" name="LocationFound" placeholder="Location Found" />
                <label style="font-size:13px; font-weight:600; color:#555; margin-top:10px; display:block;">
                    Found Date
                </label>
                <input type="date" name="DateFound" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                <label style="font-size:13px; font-weight:600; color:#555; margin-top:10px; display:block;">
                    Attach Image
                </label>
                <input type="file" name="ImageFile" />
                <button type="submit">Submit Found Item</button>
            </form>
        </div>
    }
    else
    {
        <div class="form-box" style="text-align:center;">
            <h3>Register Found Item</h3>
            <p style="color:#888; margin-bottom:16px;margin-top:10px">You need to be logged in to register a found item.</p>
            <br/>
            <button onclick="showPopup()" style="padding:12px 28px; background:#e94560;color:white; border:none; border-radius:8px; font-size:1rem; cursor:pointer;">
                + Register Found Item
            </button>
        </div>
    }


    <div class="list-box">
        <h3>Found Items</h3>

        @if (Model?.Any() == true)
        {
            @foreach (var item in Model)
            {
                <div class="card">

                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" />
                    }
                    else
                    {
                        <img src="/images/default.jpg" />
                    }

                    <div>
                        <h4>@item.ItemName</h4>
                        <p>@item.Description</p>
                        <p><b>Location:</b> @item.LocationFound</p>
                        <p><b>Found on:</b> @item.DateFound?.ToString("dd-MM-yyyy")</p>
                        <p><b>Found By:</b> @users?.FirstOrDefault(u => u.UserId == item.UserId)?.FullName</p>
                        <p><b>Contact:</b> @users?.FirstOrDefault(u => u.UserId == item.UserId)?.Phone</p>
                        <span class="status">@item.Status</span>

                        @if (item.Status != "resolved" && item.UserId == currentUserId)
                        {
                            <form method="post" asp-action="ResolveFound">
                                <input type="hidden" name="id" value="@item.FoundId" />
                                <button type="submit" class="btn">Mark Resolved</button>
                            </form>
                        }
                        else if (item.Status == "resolved")
                        {
                            <span style="color:green; font-weight:bold;">Resolved ✔</span>
                        }
                    </div>

                </div>
            }
        }
        else
        {
            <p>No found items found.</p>
        }
    </div>

    <script>
            function showPopup() {
                var popup = document.getElementById('loginPopup');
                popup.style.display = 'flex';
            }
            function closePopup() {
                var popup = document.getElementById('loginPopup');
                popup.style.display = 'none';
            }
            window.onclick = function(e) {
                var popup = document.getElementById('loginPopup');
                if (e.target === popup) closePopup();
            }
    </script>

</body>
</html>